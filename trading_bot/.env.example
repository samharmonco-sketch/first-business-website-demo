# Copy to trading_bot/.env and fill in. Never commit the real .env.

# --- Mode ---
# paper = simulated fills against live market data (default, safe)
# live  = real orders on Kalshi (only after you explicitly flip this)
TRADING_MODE=paper

# --- Kalshi ---
# Kalshi auth is API-Key-ID + RSA private key (PEM), not a plain secret.
KALSHI_API_KEY_ID=
# Paste the full PEM contents, or point to a file path instead via KALSHI_PRIVATE_KEY_PATH
KALSHI_PRIVATE_KEY_PATH=trading_bot/data/kalshi_private_key.pem
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
# Kalshi's demo/paper environment, if you have a demo account instead of prod read-only:
# KALSHI_BASE_URL=https://demo-api.kalshi.co/trade-api/v2

# --- Sports odds ---
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# --- Anthropic (AI sports analysis) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Bankroll / risk (paper mode defaults, generous but not infinite) ---
PAPER_STARTING_BANKROLL=10000
MAX_POSITION_PCT=0.05
MAX_POSITION_ABS=500
MAX_TOTAL_EXPOSURE_PCT=0.50
DAILY_LOSS_LIMIT_PCT=0.15
MAX_EXPOSURE_PER_MARKET_PCT=0.10
MAX_EXPOSURE_PER_STRATEGY_PCT=0.30
MAX_EXPOSURE_PER_UNDERLYING_PCT=0.15

# --- Exit logic (take-profit / stop-loss on open positions) ---
TAKE_PROFIT_PCT=0.50
STOP_LOSS_PCT=0.40

# --- Day-one permissive mode ---
DAY_ONE_MODE_ENABLED=true
DAY_ONE_MAX_POSITION_ABS=50
DAY_ONE_MIN_EDGE=0.03

# --- Polling ---
POLL_INTERVAL_SECONDS=60
