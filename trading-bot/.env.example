# Copy this file to .env and fill in real values. Never commit .env.

# Overrides config.yaml's top-level "mode" field. Leave unset to use whatever
# config.yaml says (defaults to "paper"). Set to "live" only when you are
# ready for real orders -- this repo will refuse to start in live mode
# without valid Kalshi credentials below.
TRADING_BOT_MODE=paper

# Kalshi API credentials (Settings > API Keys in the Kalshi UI). Generate an
# RSA key pair locally, upload the PUBLIC key to Kalshi, and point
# KALSHI_PRIVATE_KEY_PATH at the PRIVATE key file (never upload or commit
# the private key).
#   openssl genrsa -out kalshi_private_key.pem 2048
#   openssl rsa -in kalshi_private_key.pem -pubout -out kalshi_public_key.pem
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem

# true = Kalshi's demo/sandbox environment (fake money, real API surface).
# Use this for your first live-mode dry run before pointing at production.
KALSHI_USE_DEMO=true

# Anthropic API key, used by the AI sports analysis strategy (sports_ai) to
# call Claude for probability/confidence estimates on sports markets.
ANTHROPIC_API_KEY=
